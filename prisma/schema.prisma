// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
  relationMode = "prisma"
}

enum Role {
  user
  assistant
}

enum CampaignStatus {
  active
  completed
  paused
  draft
}

enum ActivityType {
  distribution
  campaign_scheduled
  order_shipped
  premiere_scheduled
  revenue_update
  stream_update
}

enum DistributionPlatform {
  spotify
  apple_music
  youtube
  instagram
  tiktok
  facebook
  twitter
  website
}

model User {
  id           String  @id @default(cuid()) @map("_id")
  clerkId      String  @unique
  email        String  @unique
  name         String?
  avatar       String?
  bio          String?
  location     String?
  website      String?

  account      Account?
  portfolio    Portfolio?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Account {
  id              String   @id @default(cuid()) @map("_id")
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Metrics
  totalRevenue    Float    @default(0)
  totalStreams    Int      @default(0)
  merchandiseSales Int    @default(0)
  
  // Relations
  campaigns       Campaign[]
  activities      Activity[]
  merchandise     Merchandise[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Campaign {
  id              String         @id @default(cuid()) @map("_id")
  accountId       String
  account         Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  
  title           String
  description     String?
  status          CampaignStatus @default(draft)
  progress        Int            @default(0) // 0-100
  endDate         DateTime
  platforms       DistributionPlatform[]
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  
  @@index([accountId])
}

model Activity {
  id              String       @id @default(cuid()) @map("_id")
  accountId       String
  account         Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  
  type            ActivityType
  title           String
  description     String?
  metadata        String?      // JSON string for additional data
  
  createdAt       DateTime     @default(now())
  
  @@index([accountId])
  @@index([createdAt])
}

model Merchandise {
  id              String   @id @default(cuid()) @map("_id")
  accountId       String
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  
  name            String
  description     String?
  price           Float
  quantity        Int      @default(0)
  imageUrl        String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([accountId])
}

// Portfolio (creator portfolio / one per user)
model Portfolio {
  id              String   @id @default(cuid()) @map("_id")
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug            String
  title           String
  description     String?
  coverImage      String?
  theme           String   @default("default")
  metaTitle       String?
  metaDescription String?
  customDomain    String?
  isPublished     Boolean  @default(false)

  projects        Project[]
  skills          Skill[]
  socialLinks     SocialLink[]
  experiences     Experience[]
  testimonials    Testimonial[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Project {
  id            String   @id @default(cuid()) @map("_id")
  portfolioId   String
  portfolio     Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  slug          String
  title         String
  description   String?
  content       String?
  coverImage    String?
  images        String[]
  tags          String[]
  status        String   @default("draft") // draft | published | archived
  featured      Boolean  @default(false)
  order         Int      @default(0)
  client        String?
  year          Int?
  category      String?
  technologies  String[]
  liveUrl       String?
  githubUrl     String?
  caseStudyUrl  String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([portfolioId])
}

model Skill {
  id          String   @id @default(cuid()) @map("_id")
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  name        String
  category    String?
  level       Int      @default(50)
  icon        String?
  isVisible   Boolean  @default(true)
  order       Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([portfolioId])
}

enum SocialPlatform {
  instagram
  twitter
  youtube
  tiktok
  linkedin
  github
  behance
  dribbble
  website
  other
}

model SocialLink {
  id          String        @id @default(cuid()) @map("_id")
  portfolioId String
  portfolio   Portfolio     @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  platform    SocialPlatform
  url         String
  label       String?
  icon        String?
  isVisible   Boolean       @default(true)
  order       Int           @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([portfolioId])
}

model Experience {
  id          String   @id @default(cuid()) @map("_id")
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  title       String?
  company     String?
  order       Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([portfolioId])
}

model Testimonial {
  id          String   @id @default(cuid()) @map("_id")
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  quote       String?
  author      String?
  order       Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([portfolioId])
}

// Link in Bio — one link for all your content
model LinkInBio {
  id              String   @id @default(cuid()) @map("_id")
  slug            String   @unique
  displayName     String?
  bio             String?
  avatarUrl       String?
  theme           String   @default("default") // default, minimal, gradient
  backgroundColor String?  @default("#0a0a0a")
  buttonColor     String?  @default("#ffffff")
  buttonTextColor String?  @default("#0a0a0a")

  links LinkInBioLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LinkInBioLink {
  id          String    @id @default(cuid()) @map("_id")
  linkInBioId String
  linkInBio   LinkInBio @relation(fields: [linkInBioId], references: [id], onDelete: Cascade)

  title String
  url   String
  order Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([linkInBioId])
}

// Monetization — products, tips, payment links for creators
model MonetizationProfile {
  id          String   @id @default(cuid()) @map("_id")
  slug        String   @unique
  displayName String?
  bio         String?
  avatarUrl   String?
  currency    String   @default("USD")

  products     MonetizationProduct[]
  cryptoWallets MonetizationCryptoWallet[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MonetizationCryptoWallet {
  id        String   @id @default(cuid()) @map("_id")
  profileId String
  profile   MonetizationProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  network String   // ethereum, polygon, tron, arbitrum, base, bsc
  address String
  order   Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
}

model MonetizationProduct {
  id          String   @id @default(cuid()) @map("_id")
  profileId   String
  profile     MonetizationProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  name        String
  description String?
  price       Float    // e.g. 9.99
  currency    String   @default("USD")
  type        String   @default("one-time") // one-time, subscription, tip
  paymentUrl  String   // Stripe, Ko-fi, Gumroad, etc.
  order       Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
}

// --- Agency Program (creator agency program) ---

enum AgencyApplicationStatus {
  applied
  in_review
  accepted
  rejected
  completed
}

enum AgencyTaskStatus {
  pending
  submitted
  approved
  needs_changes
}

enum AgencySubmissionType {
  link
  text
}

enum AgencySubmissionStatus {
  submitted
  approved
  needs_changes
}

enum AuthRole {
  user
  admin
}

model AuthUserRole {
  id         String   @id @default(cuid()) @map("_id")
  authUserId String   @unique
  role       AuthRole @default(user)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AgencyApplication {
  id               String                  @id @default(cuid()) @map("_id")
  status           AgencyApplicationStatus @default(applied)

  // Applicant info (public application)
  name             String
  email            String
  socials          String? // JSON string { instagram, tiktok, youtube, website, ... }
  goal             String? // why join / what they want to build
  brandStage       String? // optional

  // Linked account (Better Auth user id)
  claimedAuthUserId String? @unique

  adminNotes       String?
  acceptedAt       DateTime?
  completedAt      DateTime?

  taskAssignments  AgencyTaskAssignment[]
  entitlements     AgencyEntitlement[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([email])
  @@index([status])
}

model AgencyTaskTemplate {
  id          String   @id @default(cuid()) @map("_id")
  title       String
  description String?
  required    Boolean  @default(true)
  order       Int      @default(0)
  isActive    Boolean  @default(true)

  assignments AgencyTaskAssignment[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
  @@index([isActive])
}

model AgencyTaskAssignment {
  id             String           @id @default(cuid()) @map("_id")
  applicationId  String
  application    AgencyApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  templateId     String
  template       AgencyTaskTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  status         AgencyTaskStatus  @default(pending)
  dueAt          DateTime?

  submissions    AgencyTaskSubmission[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([applicationId, templateId])
  @@index([applicationId])
  @@index([status])
}

model AgencyTaskSubmission {
  id            String                 @id @default(cuid()) @map("_id")
  assignmentId  String
  assignment    AgencyTaskAssignment   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  type          AgencySubmissionType
  content       String

  status        AgencySubmissionStatus @default(submitted)
  reviewerNotes String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([assignmentId])
  @@index([status])
}

model AgencyEntitlement {
  id             String            @id @default(cuid()) @map("_id")
  applicationId  String
  application    AgencyApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  type           String // e.g. brand_scaling, ai_saas_build
  metadata       String? // JSON string
  active         Boolean @default(true)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([applicationId, type])
  @@index([applicationId])
  @@index([type])
}

